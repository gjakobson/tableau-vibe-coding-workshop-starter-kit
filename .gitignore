# Claude Code local settings — personal to each machine
.claude/settings.local.json

# Credentials & secrets — NEVER commit these
tableau_config.json
next_config.json
sf_private_key.pem
sf_certificate.crt

# Template files are safe to commit
!next_config.template.json

# Python cache
__pycache__/
*.pyc
*.pyo

# Binary / generated data files
*.hyper
*.tdsx
*.zip
*.pdf

# D3 static resource — fetched fresh from CDN by _deploy_lwc.py
force-app/main/default/staticresources/d3.js

# macOS
.DS_Store

# Org credentials — machine-specific, never commit
next_orgs.json
next_demos.json

# Bank-specific demo outputs
*_next_demo.py
*_demo_guide.md
*_dashboard.py
*_fix.py

